---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Kanban Board - Login">
  <main id="app">
    <div class="login-container">
      <form class="login-form" id="login-form" onsubmit="handleLogin(event)">
        <h1>Tablero Kanban</h1>
        <div class="form-group">
          <label for="password">Contraseña</label>
          <input 
            type="password" 
            id="password" 
            name="password" 
            required 
            placeholder="Ingresa la contraseña"
            autocomplete="off"
          />
        </div>
        <button type="submit" class="login-btn">Acceder</button>
        <div id="error-message" class="error-message" style="display: none;"></div>
      </form>
    </div>

    <!-- Kanban Board Modal (hidden initially) -->
    <div id="kanban-container" style="display: none;"></div>

    <!-- Modal for adding tasks -->
    <div id="task-modal" class="modal">
      <div class="modal-content">
        <div class="modal-header">
          <h2 id="modal-title">Agregar Tarea</h2>
          <button type="button" class="close-btn" onclick="closeTaskModal()">&times;</button>
        </div>
        <form id="task-form" onsubmit="submitTask(event)">
          <div class="form-group">
            <label for="task-title">Título</label>
            <input type="text" id="task-title" required placeholder="Título de la tarea" />
          </div>
          <div class="form-group">
            <label for="task-description">Descripción</label>
            <textarea id="task-description" placeholder="Descripción de la tarea"></textarea>
          </div>
          <div class="form-group">
            <label for="task-priority">Prioridad</label>
            <select id="task-priority">
              <option value="baja">Baja</option>
              <option value="media" selected>Media</option>
              <option value="alta">Alta</option>
            </select>
          </div>
          <div class="form-group">
            <label for="task-due-date">Fecha Límite</label>
            <input type="date" id="task-due-date" />
          </div>
          <div class="modal-buttons">
            <button type="button" class="btn btn-secondary" onclick="closeTaskModal()">Cancelar</button>
            <button type="submit" class="btn btn-primary">Guardar</button>
          </div>
        </form>
      </div>
    </div>
  </main>

  <script>
    let token = null;
    let currentColumnId = null;
    let editingTaskId = null;

    // Check if already logged in
    document.addEventListener('DOMContentLoaded', () => {
      const storedToken = localStorage.getItem('kanban_token');
      if (storedToken) {
        token = storedToken;
        showKanban();
      }
    });

    async function handleLogin(event) {
      event.preventDefault();
      const password = document.getElementById('password').value;
      const errorEl = document.getElementById('error-message');

      try {
        const response = await fetch('/api/login', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({ password }),
        });

        if (response.ok) {
          const data = await response.json();
          token = data.token;
          localStorage.setItem('kanban_token', token);
          errorEl.style.display = 'none';
          document.getElementById('login-form').reset();
          showKanban();
        } else {
          errorEl.textContent = 'Contraseña incorrecta';
          errorEl.style.display = 'block';
        }
      } catch (error) {
        errorEl.textContent = 'Error de conexión';
        errorEl.style.display = 'block';
      }
    }

    async function showKanban() {
      document.querySelector('.login-container').style.display = 'none';
      document.getElementById('kanban-container').style.display = 'block';

      // Load kanban board
      await loadColumns();
    }

    async function loadColumns() {
      try {
        const response = await fetch('/api/columns', {
          headers: {
            'Authorization': `Bearer ${token}`,
          },
        });

        if (response.ok) {
          const columns = await response.json();
          renderKanban(columns);
        } else if (response.status === 401) {
          logout();
        }
      } catch (error) {
        console.error('Error loading columns:', error);
      }
    }

    function renderKanban(columns) {
      const container = document.getElementById('kanban-container');
      
      let html = `
        <div class="kanban-board">
          <div class="kanban-header">
            <h1>Mi Tablero Kanban</h1>
            <button class="logout-btn" onclick="logout()">Cerrar sesión</button>
          </div>
          <div class="kanban-container">
      `;

      columns.forEach(column => {
        html += `
          <div class="column" data-column-id="${column.id}">
            <div class="column-header">
              <h2>${column.name}</h2>
              <span class="task-count">${column.tasks ? column.tasks.length : 0}</span>
            </div>
            <div class="tasks-list" data-column-id="${column.id}">
        `;

        if (column.tasks && column.tasks.length > 0) {
          column.tasks.forEach(task => {
            const priorityColor = {
              'baja': '#90EE90',
              'media': '#FFD700',
              'alta': '#FF6B6B'
            };
            const dueDate = task.due_date ? new Date(task.due_date).toLocaleDateString('es-ES') : null;
            
            html += `
              <div class="card" data-task-id="${task.id}">
                <div class="card-header">
                  <h3>${task.title}</h3>
                  <button class="delete-btn" onclick="deleteTask(${task.id})" type="button">&times;</button>
                </div>
                ${task.description ? `<p class="description">${task.description}</p>` : ''}
                <div class="card-footer">
                  ${task.priority ? `<span class="priority" style="background-color: ${priorityColor[task.priority] || '#ccc'}">${task.priority}</span>` : ''}
                  ${dueDate ? `<span class="due-date">${dueDate}</span>` : ''}
                </div>
              </div>
            `;
          });
        }

        html += `
            </div>
            <button class="add-task-btn" onclick="openAddTaskModal(${column.id})" type="button">+ Agregar tarea</button>
          </div>
        `;
      });

      html += `
          </div>
        </div>
      `;

      container.innerHTML = html;
      initSortable();
    }

    function initSortable() {
      const taskLists = document.querySelectorAll('.tasks-list');
      
      // Dynamically import Sortable (fallback to vanilla drag-drop if not available)
      taskLists.forEach(list => {
        // Enable native drag and drop
        list.addEventListener('dragover', (e) => {
          e.preventDefault();
          e.dropEffect = 'move';
          list.style.backgroundColor = 'rgba(0,0,0,0.05)';
        });

        list.addEventListener('dragleave', () => {
          list.style.backgroundColor = '';
        });

        list.addEventListener('drop', async (e) => {
          e.preventDefault();
          list.style.backgroundColor = '';
          
          const taskId = e.dataTransfer.getData('text/plain');
          const columnId = list.getAttribute('data-column-id');
          
          if (taskId && columnId) {
            await updateTask(parseInt(taskId), { column_id: parseInt(columnId) });
          }
        });
      });

      const cards = document.querySelectorAll('.card');
      cards.forEach(card => {
        card.draggable = true;
        card.addEventListener('dragstart', (e) => {
          e.dataTransfer.effectAllowed = 'move';
          e.dataTransfer.setData('text/plain', card.getAttribute('data-task-id'));
          card.style.opacity = '0.5';
        });

        card.addEventListener('dragend', () => {
          card.style.opacity = '';
        });
      });
    }

    function openAddTaskModal(columnId) {
      currentColumnId = columnId;
      editingTaskId = null;
      document.getElementById('modal-title').textContent = 'Agregar Tarea';
      document.getElementById('task-form').reset();
      document.getElementById('task-modal').classList.add('active');
    }

    function closeTaskModal() {
      document.getElementById('task-modal').classList.remove('active');
      currentColumnId = null;
      editingTaskId = null;
    }

    async function submitTask(event) {
      event.preventDefault();

      const title = document.getElementById('task-title').value;
      const description = document.getElementById('task-description').value;
      const priority = document.getElementById('task-priority').value;
      const dueDate = document.getElementById('task-due-date').value;

      const taskData = {
        title,
        description,
        priority,
        due_date: dueDate || null,
        column_id: currentColumnId,
      };

      try {
        const url = editingTaskId ? `/api/tasks/${editingTaskId}` : '/api/tasks';
        const method = editingTaskId ? 'PUT' : 'POST';

        const response = await fetch(url, {
          method,
          headers: {
            'Content-Type': 'application/json',
            'Authorization': `Bearer ${token}`,
          },
          body: JSON.stringify(taskData),
        });

        if (response.ok) {
          closeTaskModal();
          await loadColumns();
        } else {
          alert('Error al guardar la tarea');
        }
      } catch (error) {
        console.error('Error:', error);
        alert('Error de conexión');
      }
    }

    async function deleteTask(taskId) {
      if (confirm('¿Estás seguro de que quieres eliminar esta tarea?')) {
        try {
          const response = await fetch(`/api/tasks/${taskId}`, {
            method: 'DELETE',
            headers: {
              'Authorization': `Bearer ${token}`,
            },
          });

          if (response.ok) {
            await loadColumns();
          } else {
            alert('Error al eliminar la tarea');
          }
        } catch (error) {
          console.error('Error:', error);
        }
      }
    }

    async function updateTask(taskId, updates) {
      try {
        const response = await fetch(`/api/tasks/${taskId}`, {
          method: 'PUT',
          headers: {
            'Content-Type': 'application/json',
            'Authorization': `Bearer ${token}`,
          },
          body: JSON.stringify(updates),
        });

        if (response.ok) {
          await loadColumns();
        }
      } catch (error) {
        console.error('Error:', error);
      }
    }

    function logout() {
      localStorage.removeItem('kanban_token');
      token = null;
      document.querySelector('.login-container').style.display = 'flex';
      document.getElementById('kanban-container').style.display = 'none';
      document.getElementById('login-form').reset();
    }
  </script>
</Layout>
